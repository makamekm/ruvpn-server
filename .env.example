# Required: paste the complete Telemost invite URL or only its room id.
# Example: https://telemost.yandex.ru/j/12345678901234
RUPN_TELEMOST_ROOM=

RUPN_CONNECTION_TYPE=telemost
RUPN_LINK=direct
RUPN_DNS=
RUPN_VP8_FPS=60
RUPN_VP8_BATCH=32

# Leave empty for fresh random values and a new JWT on every service start.
# Set both to keep the same JWT. Generate a key with: openssl rand -hex 32
RUPN_DEVICE_NAME=
RUPN_CLIENT_KEY=
# Legacy aliases: RUPN_CLIENT_ID and RUPN_KEY_HEX

RUPN_JWT_SECRET=rupn
RUPN_DEBUG=false
RUPN_PRINT_RAW_URI=false
RUPN_ROTATE_ON_START=false

# Bad-log restarts are opt-in. VP8 zero/frozen-ingress recovery is enabled by
# default because Telemost can attach a remote video track while ingress is zero.
RUPN_ENABLE_BAD_LOG_RESTART_WATCHDOG=false
RUPN_BAD_AFTER_SECONDS=0
RUPN_ENABLE_VP8_RESTART_WATCHDOG=true
RUPN_VP8_INGRESS_FROZEN_AFTER_SECONDS=60
RUPN_VP8_ZERO_INGRESS_AFTER_SECONDS=30
RUPN_VP8_RESTART_BACKOFF_SECONDS=600
RUPN_RESTART_BACKOFF_SECONDS=2

# Optional external room factory. Not needed when RUPN_TELEMOST_ROOM is set.
RUPN_TELEMOST_ROOM_FACTORY_URL=

# Optional upstream SOCKS5 proxy for server egress:
# RUPN_SOCKS_PROXY=127.0.0.1
# RUPN_SOCKS_PROXY_PORT=1080
