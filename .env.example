# Required: paste the complete Telemost invite URL or only its room id.
# Example: https://telemost.yandex.ru/j/12345678901234
RUPN_TELEMOST_ROOM=

RUPN_CONNECTION_TYPE=telemost
RUPN_LINK=direct
RUPN_DNS=

# Let VPN clients reach this server's local network (e.g. http://192.168.0.209:8080)
# as if they were on it. Off by default: keep it off on cloud servers.
# RUPN_LAN_SUBNETS takes comma-separated private CIDRs; empty means the /24
# around a private DNS server (the home router). Changing it changes the JWT.
# Run the container with host networking (network_mode: host) so services on
# the Docker host itself are reachable too.
RUPN_LAN_ACCESS=false
RUPN_LAN_SUBNETS=

# Direct peer-to-peer path (many times faster than the conference path; the
# tunnel falls back to the conference automatically when it is unavailable).
# Set a free UDP+TCP port to enable it; each server on one host needs its own.
# Home server: the router is asked to forward the port via NAT-PMP.
# Cloud server: open the port (UDP and TCP) in the provider firewall/security
# group; the public address is taken from the interface or found via STUN,
# RUPN_DIRECT_PUBLIC_IP overrides it.
# Docker: use host networking (network_mode: host) or publish the port with
# the same number for udp and tcp (e.g. -p 40400:40400/udp -p 40400:40400/tcp).
RUPN_DIRECT_PORT=0
RUPN_DIRECT_PUBLIC_IP=
RUPN_DIRECT_NATPMP=true
RUPN_VP8_FPS=60
RUPN_VP8_BATCH=32

# Leave empty for fresh random values and a new JWT on every service start.
# Set both to keep the same JWT. Generate a key with: openssl rand -hex 32
RUPN_DEVICE_NAME=
RUPN_CLIENT_KEY=
# Legacy aliases: RUPN_CLIENT_ID and RUPN_KEY_HEX

RUPN_JWT_SECRET=rupn
RUPN_DEBUG=false
RUPN_PRINT_RAW_URI=false
RUPN_ROTATE_ON_START=false

# Bad-log restarts are opt-in. VP8 zero/frozen-ingress recovery is enabled by
# default because Telemost can attach a remote video track while ingress is zero.
RUPN_ENABLE_BAD_LOG_RESTART_WATCHDOG=false
RUPN_BAD_AFTER_SECONDS=0
RUPN_ENABLE_VP8_RESTART_WATCHDOG=true
RUPN_VP8_INGRESS_FROZEN_AFTER_SECONDS=60
RUPN_VP8_ZERO_INGRESS_AFTER_SECONDS=30
RUPN_VP8_RESTART_BACKOFF_SECONDS=600
RUPN_RESTART_BACKOFF_SECONDS=2

# Optional external room factory. Not needed when RUPN_TELEMOST_ROOM is set.
RUPN_TELEMOST_ROOM_FACTORY_URL=

# Optional upstream SOCKS5 proxy for server egress:
# RUPN_SOCKS_PROXY=127.0.0.1
# RUPN_SOCKS_PROXY_PORT=1080
